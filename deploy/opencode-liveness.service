[Unit]
Description=opencode-liveness supervisor (per-second liveness verdicts)
After=default.target

[Service]
Type=simple
# Use deploy/install.sh: it installs to the user prefix and enables lingering, so this unit starts at
# boot. Installing to /usr/local/bin and putting the socket in /run meant a WSL restart removed the
# daemon, the socket and the state — and because the plugin treats a missing daemon as free, the
# outage was silent.
ExecStart=%h/.local/bin/liveness-daemon
Restart=always
RestartSec=2
# The watchdog cannot be watched by itself: a frozen sampler loop stops pings and systemd restarts it.
WatchdogSec=10
NotifyAccess=main
Environment=LIVENESS_DIR=/tmp/opencode-liveness

[Install]
WantedBy=default.target
